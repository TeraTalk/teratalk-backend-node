# Copy to .env and fill values.

# Optional: Teratalk ML FastAPI (see /teratalk-ml-service/README.md)
# Must be reachable FROM this Node process. Docker on Windows: http://host.docker.internal:8090
# If you omit http://, it is added automatically (e.g. 127.0.0.1:8090 -> http://127.0.0.1:8090).
ML_SERVICE_URL=http://localhost:8090
ML_INTERNAL_API_KEY=
ML_WORDS_ENABLED=1
ML_SPEECH_LEVEL_ENABLED=1
ML_HINTS_ENABLED=1
